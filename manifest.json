{
  "manifest_version": 3,
  "name": "FBot - BacBo Listas",
  "version": "1.0.2",
  "description": "FBot - BacBo Listas. Automação de entradas por lista de horários.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "webNavigation",
    "debugger",
    "sidePanel",
    "windows"
  ],
  "host_permissions": ["*://*/*"],
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "FBot - BacBo Listas"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["js/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "js/background.js"
  }
}
